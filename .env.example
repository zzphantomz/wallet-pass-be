PORT=3000

# PEM files produced by scripts/convert-p12.sh
WALLET_PASS_SIGNER_CERT=certs/signerCert.pem
WALLET_PASS_SIGNER_KEY=certs/signerKey.pem
WALLET_PASS_SIGNER_KEY_PASSPHRASE=
WALLET_PASS_WWDR=certs/wwdr.pem

# Deploys: PEM content as base64 instead of files (takes precedence over the paths above)
# base64 -i certs/signerKey.pem | tr -d '\n'
WALLET_PASS_SIGNER_CERT_BASE64=
WALLET_PASS_SIGNER_KEY_BASE64=
WALLET_PASS_WWDR_BASE64=
